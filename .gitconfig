[user]
	name  = Marco Otte-Witte
	email = marco.otte-witte@mainmatter.com
  signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAII3O2WuEO3vSw3H9I0P3fvS30JP9qKH6jWtIKu5feYBi
  
[credential]
  helper = osxkeychain

[alias]
  sh     = !git-sh
  st     = !git-status
  ss     = !git-status -s
  ci     = !git-commit -v
  co     = !git-checkout
  a      = !git-add
  grab   = !git-grab
  thanks = !git-thanks
  cv     = !git-cv
  track  = !git-track
  ll     = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]%C(cyan)" --decorate --name-status
  ls     = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate
  review = log -p --max-count=1
  extlog = log --stat
  wip    = !git add -u && git commit -m ...
  wipc   = !date >> WIP && git add WIP && git commit -m ...
  fp     = format-patch --stdout
  cp     = cherry-pick
  sm     = submodule
  cntn   = branch --contains
  undo   = reset --soft HEAD^
  last   = diff HEAD^ HEAD
  fpush  = push --force-with-lease

[commit]
  template = ~/.gitmessage
  gpgsign  = true

[commit]
  gpgsign  = true

[core]
  filemode         = true
  logallrefupdates = true
  whitespace       = space-before-tab, trailing-space, blank-at-eol, blank-at-eof
  pager            = less -r
  autocrlf         = input
	excludesfile     = /Users/marcoow/.gitignore-global
  ignorecase       = false

[branch]
  autosetupmerge = true
  autosetupmerge = always
  sort           = -committerdate

[diff]
  renames        = copies
  mnemonicprefix = true
  algorithm      = patience

[help]
  browser = open

[sendemail]
  smtpserver     = smtp.gmail.com
  smtpserverport = 587
  smtpencryption = tls
  smtpuser       = marco.otte-witte@simplabs.com

[color]
  ui = auto

[color "diff"]
  meta = blue bold
  frag = magenta bold
  old  = red bold
  new  = green bold

[color "branch"]
  current = yellow reverse
  local   = yellow bold
  remote  = green bold
  plain   = red bold

[color "status"]
  added     = yellow
  changed   = green bold
  untracked = blue bold

[advice]
  statusHints = false

[rerere]
  enabled    = true
  autoUpdate = true

[push]
  default         = current
  autosetupremote = true

[init]
  defaultBranch = main

[gpg]
  format = ssh

[gpg "ssh"]
  program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"

[credential "https://github.com"]
	helper = !/opt/homebrew/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper = !/opt/homebrew/bin/gh auth git-credential
