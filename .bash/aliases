alias git-deleted-stashes="git fsck --unreachable | grep commit | cut -d\  -f3 | xargs git log --merges --no-walk --grep=WIP"
alias cat=ccat
alias git="LANG=en_US.UTF-8 git"
alias shrink-pdf="gs -sDEVICE=pdfwrite -dPDFSETTINGS=/ebook -dNOPAUSE -dQUIET -dBATCH -sOutputFile="./shrunk.pdf""
alias topdfa="gs -dPDFA=2 -dBATCH -dNOPAUSE -dNOOUTERSAVE -sDEVICE=pdfwrite -sColorConversionStrategy=UseDeviceIndependentColor -dPDFACompatibilityPolicy=1 -sOutputFile="./pdfa.pdf""
